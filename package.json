{
  "displayName": "Homebridge Shortcuts Buttons",
  "name": "homebridge-shortcuts-buttons",
  "version": "3.5.6",
  "description": "Run any Apple Shortcut with just the tap of a button, and execute a custom unix command (or another shortcut!) after completion to handle its success/failure, using x-callback-url.",
  "license": "Apache-2.0",
  "author": "duddu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duddu/homebridge-shortcuts-buttons.git"
  },
  "homepage": "https://github.com/duddu/homebridge-shortcuts-buttons#readme",
  "bugs": {
    "url": "https://github.com/duddu/homebridge-shortcuts-buttons/issues"
  },
  "engines": {
    "node": "^18.20.4 || ^20.18.0 || ^22.10.0 || ^24.8.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "jest --verbose --forceExit --detectOpenHandles --no-cache",
    "test:watch": "npm run test -- --watch --no-coverage --cache",
    "test:quiet": "npm run test -- --silent --verbose false --no-coverage",
    "convertSchema": "tsx ./bin/convertSchema.ts",
    "bundle": "rimraf ./dist && tsc && cp -R ./src/bin ./dist",
    "build": "npm run convertSchema && npm run bundle",
    "link": "npm run build && npm link",
    "watch": "npm run link && nodemon",
    "lint": "eslint {src,test}/**/*.ts && npm run prettier",
    "prettier": "prettier --log-level warn --check .",
    "prettier:write": "npm run prettier -- --write",
    "typedoc": "typedoc --placeInternalsInOwningModule --mergeModulesMergeMode module",
    "prepublishOnly": "npm ci && npm audit signatures && npm run test:quiet && npm run build",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@jest/globals": "^30.1.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^24.3.3",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.35.0",
    "homebridge": "^2.0.0-beta.30",
    "husky": "^9.1.7",
    "json-schema-to-typescript": "^15.0.4",
    "lodash": "^4.17.21",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.2.8",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typedoc": "^0.28.12",
    "typedoc-plugin-merge-modules": "^7.0.0",
    "typedoc-plugin-missing-exports": "^4.1.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "glob": ">=9.3.5",
    "rimraf": "$rimraf"
  },
  "keywords": [
    "apple-home",
    "apple-shortcuts",
    "homebridge",
    "homebridge-plugin",
    "homekit",
    "shortcuts",
    "x-callback-url"
  ]
}
